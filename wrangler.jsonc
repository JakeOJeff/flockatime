{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flockatime",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },

  // Public hostname. The install scripts and the Hack Club Auth redirect are
  // built from the request origin, so they follow whichever host is used.
  "routes": [{ "pattern": "flockatime.curiousengine.org", "custom_domain": true }],

  // The Worker runs first and explicitly falls through to env.ASSETS for
  // anything that is not an API route, so SPA fallback can never swallow
  // /v1/*, /api/* or /auth/*.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/auth/*", "/healthz", "/install.ps1", "/install.sh"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flockatime",
      // D1 is the only storage binding: file lists live in the trees table.
      "database_id": "b521fe7b-e77c-4864-bbf8-6bd0809e5d1b",
      "migrations_dir": "migrations"
    }
  ],


  "vars": {
    // Session clustering: gap in seconds that ends a coding session.
    "SESSION_GAP_SECONDS": "900",
    // "true" in production: /api/* needs a Hack Club Auth session.
    // .dev.vars turns it off for `wrangler dev`.
    "REQUIRE_AUTH": "true",
    // Comma-separated emails allowed to sign in to the dashboard. Empty lets
    // nobody in.
    "ALLOWED_EMAILS": "realjakeojeff@gmail.com",
    // From auth.hackclub.com/developer/apps. Not secret: the client secret and
    // SESSION_SECRET are set with `wrangler secret put`.
    "HACKCLUB_CLIENT_ID": "4754299317c020e13a6507782c25d43a",
    // Hackatime username or Slack ID for the Hackatime panel (public stats
    // only). Leave empty to use your Hack Club sign-in, or set the
    // HACKATIME_API_KEY secret instead to read private stats.
    "HACKATIME_USER": "",
    // Where the one-line installers download snapshot-agent releases from.
    "CLI_REPO": "JakeOJeff/flockatime-cli"
  }
}
